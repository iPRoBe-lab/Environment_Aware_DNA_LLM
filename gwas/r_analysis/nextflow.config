report.overwrite = true
dag.overwrite    = true

// Params defined here so they are visible to included modules.
params.pca_total    = 5
// Path to an Rscript whose R has GAPIT installed. Defaults to `Rscript` on PATH;
// override with:  nextflow run main.nf --rscript /path/to/Rscript
params.rscript      = "Rscript"
params.gapit_script = "${projectDir}/gapit_gwas.R"

// Pin BLAS/OpenMP to 1 thread per job so `cpus = 1` below is honest
// (OpenBLAS otherwise spawns one thread per core).
env {
    OPENBLAS_NUM_THREADS   = '1'
    OMP_NUM_THREADS        = '1'
    MKL_NUM_THREADS        = '1'
    VECLIB_MAXIMUM_THREADS = '1'
}

// Per-job resource request. Each GAPIT job is single-threaded and loads the
// full genotype matrix (~1 GB CSV, several GB resident).
process {
    executor = 'local'
    cpus     = 1
    memory   = '8 GB'
}

// Scheduling budget. Concurrency = min over both limits (cpus and memory).
// Tune to the host: each job peaks at ~8 GB, so RAM is usually the real limit.
executor {
    cpus   = 10
    memory = '50 GB'
}
